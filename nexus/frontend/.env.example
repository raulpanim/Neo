# Optional. Defaults to the vite dev proxy (/api -> localhost:3000, see
# vite.config.js). Only needed to point the UI at a different deployment.
VITE_API_URL=

# Only needed if the API has API_KEY set. Note this ships in the built JS
# bundle - anyone with the page can read it, same as any client-only secret.
# It gates casual/automated abuse of the public API, not a real access
# boundary for a browser-based client.
VITE_API_KEY=
