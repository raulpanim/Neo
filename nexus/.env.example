# Neo4j — must match docker-compose.yml
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_dev_pass

# API
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Optional. Without it NVD allows one request every 6.5s instead of 0.7s.
# Free from https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional. Without it host scanning falls back to the keyless InternetDB,
# which returns ports and CPEs but no versions and no port attribution.
SHODAN_API_KEY=

# Telegram bot (npm run bot). Get a token from @BotFather on Telegram -
# message it "/newbot" and follow the prompts. Without this set, `npm run
# bot` refuses to start rather than running with no way to authenticate.
TELEGRAM_BOT_TOKEN=

# Where the bot's commands fetch data from. Point this at a deployed API if
# the bot doesn't run on the same host as `npm run dev`.
NEXUS_API_URL=http://localhost:3000
